<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Backend lokalny chodzi po http://localhost:8080 (a MinIO ze zdjęciami po :9000),
	a App Transport Security domyślnie blokuje nieszyfrowany ruch. NSAllowsLocalNetworking
	otwiera wyłącznie adresy lokalne — staging i produkcja dalej muszą iść po HTTPS.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
